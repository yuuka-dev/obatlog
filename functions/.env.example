# メール送信元アドレス（.env で管理）
MAIL_FROM=noreply@example.com

# Azure AD 認証情報（Firebase Secret Manager で管理）
# Firebase コンソール → Functions → シークレット、または firebase functions:secrets:set で設定
# AZURE_TENANT_ID=（Azure Portal → Entra ID → テナントID）
# AZURE_CLIENT_ID=（Azure Portal → アプリ登録 → アプリケーションID）
# AZURE_CLIENT_SECRET=（Azure Portal → アプリ登録 → 証明書とシークレット）
