# Next.js: ブラウザに載せる値は必ず NEXT_PUBLIC_ 接頭辞（ビルド時に埋め込み）
# SEO（canonical / OG / sitemap 手動更新時の正規URL）
NEXT_PUBLIC_SITE_URL=https://obatlog.com
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Functions (api) のベース URL（末尾スラッシュなし推奨）
# 例: https://asia-northeast1-<project>.cloudfunctions.net/api
# 例（エミュ）: http://localhost:5001/<project-id>/asia-northeast1/api
NEXT_PUBLIC_FUNCTIONS_BASE_URL=
# Web Push（通知オン時）
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# AdSense（画面下部広告）
# AdSense 管理画面で作成した「広告ユニット」の Client ID / Slot ID を入れる
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ID=
